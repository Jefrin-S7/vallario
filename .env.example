# VALLARIO — Environment Variables
# Copy this file to .env.local (Next.js app) and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — only put
# public, non-sensitive values there. Everything else stays server-only.

# -----------------------------------------------------------------------
# Firebase — client SDK (public config, safe for the browser)
# Get these from Firebase Console -> Project Settings -> General -> Your apps
# -----------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3 site key) — protects Firestore/Storage/Functions
# from non-app clients. Console -> App Check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------
# Firebase — Admin SDK (SERVER ONLY, never NEXT_PUBLIC_*)
# Generate: Firebase Console -> Project Settings -> Service Accounts
#   -> Generate new private key
# -----------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes in the private key string literal, as Firebase's
# JSON export contains embedded newlines.
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------
# Digital product file storage (SERVER ONLY) — Cloudflare R2, Backblaze B2,
# or Supabase Storage's S3-compatible endpoint all work here unmodified.
# NOT Firebase Storage — Firebase Storage's free tier is tiny and its paid
# tier bills per GB served, which adds up fast for a store where every sale
# is a file download. Cloudflare R2 is the best fit: free egress, 10GB
# storage free. See DEPLOYMENT.md for setup steps.
# -----------------------------------------------------------------------
S3_ENDPOINT=
# R2 format: https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
# "auto" for R2; your actual region string for B2 or Supabase

# -----------------------------------------------------------------------
# Cashfree — https://merchant.cashfree.com  (SERVER ONLY)
# Use *_TEST_* credentials in development, live credentials only in the
# production environment. Never mix the two (see spec #53).
# -----------------------------------------------------------------------
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
# sandbox | production

# -----------------------------------------------------------------------
# PayPal — https://developer.paypal.com  (SERVER ONLY)
# -----------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# sandbox | live

# -----------------------------------------------------------------------
# Transactional email (SERVER ONLY) — pick one provider and adapt
# src/lib/server/email.ts's sendViaProvider() accordingly.
# -----------------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=orders@vallario.com

# -----------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------
# Cron protection (SERVER ONLY)
# Vercel sends this automatically as a bearer token when calling scheduled
# routes if CRON_SECRET is set in your Vercel project's environment
# variables — generate any random string, e.g. `openssl rand -hex 32`.
# -----------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------
# Site URL — used to build robots.txt / sitemap.xml with absolute URLs.
# -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
